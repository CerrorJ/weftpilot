{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@weftpilot/agent-team-kernel/protocol": [".kernel/package/types/kernel/protocol.d.ts"],
      "@weftpilot/agent-team-kernel/kernel": [".kernel/package/types/kernel/kernel.d.ts"]
    }
  },
  "include": ["apps/desktop/main", "apps/desktop/preload", "packages", "tests"]
}
